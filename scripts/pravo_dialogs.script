function remove_pripyat_makar_and_volodya(first_speaker, second_speaker)

    local simulator = alife()

    if simulator == nil then
        return
    end

    local old_makar = simulator:story_object(839)

    if old_makar ~= nil then
        simulator:release(old_makar, true)
    end

    local old_volodya = simulator:story_object(840)

    if old_volodya ~= nil then
        simulator:release(old_volodya, true)
    end
end

function actor_has_rad_herb(first_parameter, second_parameter)

    if db.actor == nil then
        return false
    end

    return db.actor:object("pravo_rad_herb") ~= nil
end

function makar_take_rad_herb(first_speaker, second_speaker)

    if db.actor == nil or second_speaker == nil then
        return
    end

    if db.actor:object("pravo_rad_herb") == nil then
        return
    end

    dialogs.relocate_item_section(
        second_speaker,
        "pravo_rad_herb",
        "out"
    )
end
