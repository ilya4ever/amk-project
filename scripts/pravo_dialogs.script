function actor_has_rad_herb(first_parameter, second_parameter)

    if db.actor == nil then
        return false
    end

    return db.actor:object("pravo_rad_herb") ~= nil
end

function freedom_leader_take_rad_herb(first_speaker, second_speaker)

    if db.actor == nil or second_speaker == nil then
        return
    end

    if db.actor:object("pravo_rad_herb") == nil then
        return
    end

    dialogs.relocate_item_section(
        second_speaker,
        "pravo_rad_herb",
        "out"
    )
end
