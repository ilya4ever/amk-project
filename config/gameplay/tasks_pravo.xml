<!-- ======================================================== -->
<!-- PRAVO STORY - ESCAPE                                     -->
<!-- ======================================================== -->

<game_task id="pravo_pri_escape_task">

    <title>Сбежать</title>

    <!-- Общая карточка задания -->
    <objective>
        <text>Спастись от отряда Долга.</text>
        <icon>amk_ui_flame_quest</icon>
        <article>pravo_pri_escape_descr</article>
       <infoportion_complete>pravo_pri_escape_done</infoportion_complete>
    </objective>

    <!-- Реальная цель -->
    <objective>
        <text>Покинуть район детского сада.</text>
        <infoportion_complete>pravo_pri_escape_done</infoportion_complete>
    </objective>
</game_task>

<game_task id="pravo_pri_dead_city_task">
    <title>Мёртвый город</title>

    <objective>
        <text>Разобраться, действительно ли это Припять.</text>
        <icon>amk_ui_flame_quest</icon>
        <article>pravo_pri_dead_city_descr</article>
        <infoportion_complete>pravo_pri_dead_city_wheel_reached</infoportion_complete>
    </objective>

    <objective>
        <text>Добраться до колеса обозрения.</text>
        <infoportion_complete>pravo_pri_dead_city_wheel_reached</infoportion_complete>
    </objective>
</game_task>

<game_task id="pravo_pri_find_freedom_task">

    <title>Найти отряд Свободы</title>

    <objective>
        <text>Найти отряд Свободы в гастрономе.</text>
        <icon>amk_ui_flame_quest</icon>
        <article>pravo_pri_find_freedom_descr</article>
        <infoportion_complete>pravo_pri_find_freedom_done</infoportion_complete>
    </objective>

    <objective>
        <text>Добраться до гастронома и поговорить с командиром отряда.</text>

        <map_location_type hint="pravo_pri_freedom_squad_hint">
            green_location
        </map_location_type>

        <object_story_id>pravo_pri_freedom_leader</object_story_id>

        <infoportion_complete>
            pravo_pri_find_freedom_done
        </infoportion_complete>
    </objective>

</game_task>

<game_task id="pravo_pri_leave_task">

    <title>Путь на Радар</title>

    <objective>
        <text>Добраться до перехода на Радар вместе с Ковбоем.</text>
        <icon>amk_ui_flame_quest</icon>
        <article>pravo_pri_leave_descr</article>
        <infoportion_complete>pravo_pri_leave_done</infoportion_complete>
        <infoportion_fail>pravo_pri_leave_failed</infoportion_fail>
    </objective>

    <objective>
        <text>Следовать за Ковбоем и Максом к переходу на Радар.</text>

        <map_location_type hint="pravo_pri_freedom_squad_hint">
            green_location
        </map_location_type>

        <object_story_id>pravo_pri_freedom_leader</object_story_id>

        <infoportion_complete>pravo_pri_leave_done</infoportion_complete>
        <infoportion_fail>pravo_pri_leave_failed</infoportion_fail>
    </objective>

</game_task>
