; Lighting calibration from the official RC7.1 preset.
r2_volumetric_lights on
r_sunshafts_mode ss_ogse
r3_dynamic_wet_surfaces on
r_lens_flare on
ssfx_inter_grass on
ssfx_hud_raindrops on
ssfx_saturation 1.1
r2_sun_lumscale 2.
r2_sun_lumscale_hemi 1.0
r2_sun_lumscale_amb 1.15
r2_sun_depth_near_scale 1
r2_sun_depth_far_scale 1
r2_tonemap on
r2_tonemap_amount 1
r2_tonemap_adaptation 3.5
r2_tonemap_lowlum 0.32
r2_tonemap_middlegray 1.85
ssfx_gloss_method 0
r2_gloss_factor 0.001
r2_gloss_min 0.5
