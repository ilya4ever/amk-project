<?xml version="1.0" encoding="windows-1251"?>
<game_dialogs>
  <dialog id="pravo_mil_barrier_intro">
    <precondition>pravo_military.is_barrier_commander</precondition>
    <has_info>pravo_mil_barrier_started</has_info>
    <dont_has_info>pravo_mil_barrier_done</dont_has_info>
    <phrase_list>
      <phrase id="0"><text>pravo_mil_barrier_0</text><next>1</next></phrase>
      <phrase id="1"><text>pravo_mil_barrier_1</text><next>2</next></phrase>
      <phrase id="2"><text>pravo_mil_ack</text><give_info>pravo_mil_barrier_done</give_info><give_info>pravo_mil_lukash_started</give_info></phrase>
    </phrase_list>
  </dialog>
  <dialog id="pravo_mil_lukash_intro">
    <precondition>pravo_military.is_lukash</precondition>
    <has_info>pravo_mil_lukash_started</has_info>
    <dont_has_info>pravo_mil_lukash_done</dont_has_info>
    <phrase_list>
      <phrase id="0"><text>pravo_mil_lukash_0</text><next>1</next></phrase>
      <phrase id="1"><text>pravo_mil_lukash_1</text><next>2</next></phrase>
      <phrase id="2"><text>pravo_mil_lukash_bar_ack</text><give_info>pravo_mil_lukash_done</give_info></phrase>
    </phrase_list>
  </dialog>
  <dialog id="pravo_mil_gift_offer">
    <precondition>pravo_mil_gift.is_traitor</precondition>
    <has_info>pravo_mil_lukash_done</has_info>
    <dont_has_info>pravo_mil_gift_accepted</dont_has_info>
    <phrase_list>
      <phrase id="0"><text>pravo_mil_gift_offer_0</text><next>1</next></phrase>
      <phrase id="1"><text>pravo_mil_gift_offer_1</text><next>2</next></phrase>
      <phrase id="2"><text>pravo_mil_gift_offer_2</text><next>3</next></phrase>
      <phrase id="3"><text>pravo_mil_gift_offer_3</text><next>4</next><next>8</next></phrase>
      <phrase id="4"><text>pravo_mil_gift_offer_4</text><next>5</next></phrase>
      <phrase id="5"><text>pravo_mil_gift_offer_5</text><next>6</next></phrase>
      <phrase id="6"><text>pravo_mil_gift_offer_6</text><next>7</next></phrase>
      <phrase id="7"><text>pravo_mil_gift_offer_7</text><action>pravo_mil_gift.accept</action></phrase>
      <phrase id="8"><text>pravo_mil_gift_decline</text></phrase>
    </phrase_list>
  </dialog>
  <dialog id="pravo_mil_gift_return">
    <precondition>pravo_military.is_lukash</precondition>
    <has_info>pravo_mil_gift_pda_found</has_info>
    <dont_has_info>pravo_mil_gift_done</dont_has_info>
    <phrase_list>
      <phrase id="0"><text>pravo_mil_gift_return_0</text><next>1</next></phrase>
      <phrase id="1"><text>pravo_mil_gift_return_1</text><next>2</next></phrase>
      <phrase id="2"><text>pravo_mil_gift_return_2</text><next>3</next></phrase>
      <phrase id="3"><text>pravo_mil_gift_return_3</text><next>4</next></phrase>
      <phrase id="4"><text>pravo_mil_gift_return_4</text><next>5</next></phrase>
      <phrase id="5"><text>pravo_mil_gift_return_5</text><action>pravo_mil_gift.finish</action></phrase>
    </phrase_list>
  </dialog>
</game_dialogs>
