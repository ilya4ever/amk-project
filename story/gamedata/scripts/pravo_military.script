-- Profile-specific dialogue preconditions; NPCs and dispatch are in spawn/XML.
local function matches(first, second, profile)
    return (first ~= nil and first:profile_name() == profile)
        or (second ~= nil and second:profile_name() == profile)
end

function is_barrier_commander(first, second)
    return matches(first, second, "mil_Svoboda_blockpost_leader")
end

function is_lukash(first, second)
    return matches(first, second, "mil_Svoboda_leader")
end
