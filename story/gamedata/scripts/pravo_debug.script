-- Development tools. No quest flags are changed by these shortcuts.
local settings = ini_file("pravo_debug.ltx")
local enabled = settings:r_bool("debug", "enabled")
local protection = settings:r_bool("debug", "protection_default")
local pending = nil
local next_restore = 0
local points = {
    {level="l11_pripyat", x=110.45354, y=-0.42856, z=227.25682, lv=221663, gv=2163},
    {level="l11_pripyat", x=-108.5, y=-1.8, z=94.43811, lv=9677, gv=2216},
    {level="l11_pripyat", x=20.47369, y=-2.19054, z=-282.98987, lv=126492, gv=2128},
    {level="l10_radar", x=32.52555, y=-0.82075, z=-65.37897, lv=20969, gv=1994},
    {level="l10_radar", x=97.46283, y=2.73152, z=86.74904, lv=42734, gv=1946},
    {level="l10_radar", x=323.35767, y=-48.36774, z=-66.44293, lv=78921, gv=2034},
    {level="l10_radar", x=634.18549, y=-43.64595, z=194.71057, lv=225576, gv=1909},
    {level="l07_military", x=93.16823, y=-1.3775, z=312.61115, lv=389493, gv=1775},
    {level="l07_military", x=-24.98838, y=-3.91275, z=-16.15631, lv=281965, gv=1593}
}
local fields = {"level", "x", "y", "z", "lv", "gv", "yaw"}

local function store_return()
    local a = db.actor
    local p = a:position()
    local point = {level=level.name(), x=p.x, y=p.y, z=p.z,
        lv=a:level_vertex_id(), gv=a:game_vertex_id(), yaw=a:direction():getH()}
    for _, key in ipairs(fields) do
        xr_logic.pstor_store(a, "pravo_debug_back_" .. key, point[key])
    end
end

local function restore_condition()
    if not enabled or not protection or db.actor == nil or not db.actor:alive() then return end
    -- OGSR exposes direct condition fields. The old actor.power setter is
    -- additive and would accumulate unapplied deltas while g_god is active.
    local condition = db.actor.conditions
    if condition == nil then return end
    condition.health = condition.max_health
    condition.power_max = 1
    condition.power = 1
    condition.radiation = 0
end

function init()
    pending = nil
    next_restore = 0
    if not enabled then
        get_console():execute("g_god off")
        return
    end
    protection = xr_logic.pstor_retrieve(db.actor, "pravo_debug_protection", protection)
    get_console():execute(protection and "g_god on" or "g_god off")
    restore_condition()
    printf("PRAVO_DEBUG: ready; god/stamina=%s; pause menu F1-F10", tostring(protection))
end

local function queue_jump(point)
    if pending ~= nil then return end
    store_return()
    -- This dedicated slot is overwritten only by subsequent debug jumps.
    get_console():execute("save pravo_debug_before_jump")
    pending = {point=point, time=time_global() + 700}
    get_console():execute("main_menu off")
end

local function give_kit()
    local a = db.actor
    local items = {wpn_ak74=1, ["ammo_5.45x39_fmj"]=8, medkit=5, antirad=5, bandage=5}
    for section, count in pairs(items) do
        if section ~= "wpn_ak74" or a:object(section) == nil then
            for i=1,count do
                alife():create(section, a:position(), a:level_vertex_id(), a:game_vertex_id(), a:id())
            end
        end
    end
end

function menu_key(dik)
    if not enabled or db.actor == nil or not db.actor:alive() then return false end
    for i=1,7 do
        if dik == DIK_keys["DIK_F" .. i] then
            queue_jump(points[i])
            return true
        end
    end
    if dik == DIK_keys.DIK_F11 then
        queue_jump(points[8])
        return true
    elseif dik == DIK_keys.DIK_F12 then
        queue_jump(points[9])
        return true
    elseif dik == DIK_keys.DIK_F8 then
        local point = {}
        for _, key in ipairs(fields) do
            point[key] = xr_logic.pstor_retrieve(db.actor, "pravo_debug_back_" .. key)
            if point[key] == nil then return true end
        end
        queue_jump(point)
        return true
    elseif dik == DIK_keys.DIK_F9 then
        if pending == nil then
            pending = {kit=true, time=time_global() + 200}
            get_console():execute("main_menu off")
        end
        return true
    elseif dik == DIK_keys.DIK_F10 then
        protection = not protection
        xr_logic.pstor_store(db.actor, "pravo_debug_protection", protection)
        get_console():execute(protection and "g_god on" or "g_god off")
        restore_condition()
        get_console():execute("main_menu off")
        return true
    end
    return false
end

function update()
    if not enabled or db.actor == nil then return end
    local now = time_global()
    if now >= next_restore then
        next_restore = now + 100
        restore_condition()
    end
    if pending == nil or now < pending.time then return end
    local action = pending
    pending = nil
    if action.kit then give_kit(); return end
    local p = action.point
    local pos = vector():set(p.x, p.y, p.z)
    if level.name() == p.level then
        db.actor:set_actor_position(pos)
        db.actor:set_actor_direction(p.yaw or 0)
    else
        level.change_level(p.gv, p.lv, pos, vector():set(0, p.yaw or 0, 0))
    end
    printf("PRAVO_DEBUG: jump to %s (%f,%f,%f)", p.level, p.x, p.y, p.z)
end

function attach_panel(menu)
    if not enabled then return end
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_pravo_debug.xml")
    menu.pravo_debug_panel = xml:InitStatic("panel", menu)
    for i=0,14 do xml:InitStatic("line" .. i, menu.pravo_debug_panel) end
    show_panel(menu, true)
end

function show_panel(menu, visible)
    if menu.pravo_debug_panel ~= nil then
        menu.pravo_debug_panel:Show(visible and db.actor ~= nil)
    end
end
