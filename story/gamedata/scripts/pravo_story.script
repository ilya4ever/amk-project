-- Clean OGSR entry point for the custom story.  No AMK globals are used here.
local initialized = false

-- Used by disabled vanilla story dialogues; custom dialogs do not use it.
function vanilla_story_disabled()
    return false
end

function init()
    initialized = true
    -- Native god mode only: no menu, teleportation or condition polling.
    get_console():execute("g_god on")
    pravo_effects.reset()
    pravo_coords.reset()
    pravo_mil_gift.reset()
end

function shutdown()
    initialized = false
    pravo_effects.reset()
    pravo_coords.reset()
    pravo_mil_gift.reset()
end

function update()
    if db.actor == nil then
        return
    end

    if not initialized then
        init()
    end

    pravo_effects.update()
    pravo_coords.update()
    pravo_mil_gift.update()
end
