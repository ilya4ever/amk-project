-- Clean OGSR entry point for the custom story.  No AMK globals are used here.
local initialized = false
local next_aftermath_check = 0

function init()
    initialized = true
    pravo_effects.reset()
    pravo_dialogs.ensure_pripyat_intro()
end

function shutdown()
    initialized = false
    next_aftermath_check = 0
    pravo_effects.reset()
end

function update()
    if db.actor == nil then
        return
    end

    if not initialized then
        init()
    end

    pravo_effects.update()

    if db.actor:has_info("pravo_pri_kindergarten_aftermath_done")
    and level.name() == "l11_pripyat" then
        local now = time_global()
        if now >= next_aftermath_check then
            next_aftermath_check = now + 1000
            pravo_dialogs.ensure_kindergarten_corpses()
        end
    end
end
