-- Native vendor task manager; story ID 6521 is registered in its parent tables.
function init_task_dialog(dlg)
    task_manager.get_random_task():init_task_dialog(dlg, "pravo_rad_trader")
end

function init_reward_dialog(dlg)
    task_manager.get_random_task():init_task_dialog(dlg, "pravo_rad_trader")
end

function has_active_task(actor, npc)
    return task_manager.has_active_vendor_task(actor, npc)
end

function task_fail(task_id, objective_index)
    return task_manager.task_fail(task_id, objective_index)
end
